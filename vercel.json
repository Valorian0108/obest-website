{
  "functions": {
    "api/product.js": {
      "includeFiles": "product.html"
    },
    "api/lucent-screens.js": {
      "includeFiles": "api/lucent-screen-research.json"
    },
    "api/sitemap.js": {
      "includeFiles": "api/lucent-screen-research.json"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/:id",
      "destination": "/api/product?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
