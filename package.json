{
  "name": "obest-link-communication-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static O-BEST Link Communication catalogue with a Vercel inquiry function.",
  "scripts": {
    "test": "node --test tests/*.test.js sanity/schemas/*.test.cjs",
    "studio": "sanity dev --port 3333",
    "studio:build": "sanity build",
    "catalogue:import:dry-run": "sanity exec sanity/scripts/migrate-products.ts -- --dry-run",
    "catalogue:import": "sanity exec sanity/scripts/migrate-products.ts --with-user-token"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@sanity/vision": "^5.31.2",
    "sanity": "^5.31.2",
    "styled-components": "^6.1.15"
  }
}
